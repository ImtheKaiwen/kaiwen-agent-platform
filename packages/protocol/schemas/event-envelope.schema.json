{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kaiwen.dev/agent/v1/event-envelope.schema.json",
  "title": "Agent event envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "type", "timestamp", "trace_id", "session_id", "payload"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^evt_[A-Za-z0-9_-]+$" },
    "type": {
      "type": "string",
      "enum": [
        "conversation.input",
        "conversation.delta",
        "conversation.completed",
        "run.started",
        "run.status",
        "run.completed",
        "run.failed",
        "tool.started",
        "tool.completed",
        "tool.failed",
        "task.created",
        "task.queued",
        "task.started",
        "task.progress",
        "task.retrying",
        "task.paused",
        "task.resumed",
        "task.completed",
        "task.failed",
        "task.cancelled",
        "job.created",
        "job.queued",
        "job.assigned",
        "job.started",
        "job.progress",
        "job.waiting",
        "job.waiting_approval",
        "job.completed",
        "job.failed",
        "job.cancel_requested",
        "job.cancelled",
        "resource.waiting",
        "resource.acquired",
        "resource.released",
        "approval.requested",
        "approval.resolved",
        "artifact.created",
        "client.connected",
        "client.capabilities",
        "client.state",
        "client_action.requested",
        "client_action.result",
        "client_action.failed",
        "lifecycle.wakeup.scheduled",
        "lifecycle.wakeup.cancelled",
        "lifecycle.cycle.started",
        "lifecycle.cycle.observing",
        "lifecycle.cycle.thinking",
        "lifecycle.cycle.acting",
        "lifecycle.cycle.persisting",
        "lifecycle.cycle.scheduling",
        "lifecycle.cycle.sleeping",
        "lifecycle.cycle.completed",
        "lifecycle.cycle.failed",
        "policy.allowed",
        "policy.denied",
        "policy.approval_required",
        "policy.review_required",
        "policy.modified",
        "trigger.event.accepted",
        "trigger.event.deduplicated",
        "trigger.wakeup.scheduled",
        "objective.created",
        "objective.status.changed",
        "watch.created",
        "watch.matched",
        "watch.expired",
        "watch.cancelled",
        "attention.created"
      ]
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "trace_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "payload": { "type": "object" }
  }
}
