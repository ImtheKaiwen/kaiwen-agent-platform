{
  "name": "@kaiwen/agent-ui",
  "version": "0.1.0-alpha.1",
  "type": "module",
  "description": "Headless semantic UI runtime for Kaiwen Agent Platform",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ImtheKaiwen/kaiwen-agent-platform.git",
    "directory": "packages/ui-agent"
  },
  "keywords": ["agent", "ai", "react", "headless", "dynamic-island"],
  "sideEffects": false,
  "files": ["dist", "README.md", "INTEGRATION.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kaiwen/agent-protocol": "0.1.0-alpha.1",
    "ajv": "^8.17.1"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3"
  }
}
